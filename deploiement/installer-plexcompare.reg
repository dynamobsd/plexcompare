Windows Registry Editor Version 5.00

; PlexCompare - installation automatique et mises a jour
; ------------------------------------------------------
; Ce fichier ecrit UNE cle de politique Chrome dans HKEY_LOCAL_MACHINE.
; Il dit a Chrome : installe cette extension-la, et va chercher ses mises
; a jour a cette adresse-la. Il ne touche a rien d autre.
;
; A executer en tant qu administrateur (clic droit > Fusionner), sur
; chaque ordinateur. Ferme Chrome completement avant, puis rouvre-le.
;
; installation_mode = normal_installed : Chrome installe l extension tout
; seul et la maintient a jour, mais tu peux encore la desactiver toi-meme.
; Pour tout retirer, execute desinstaller-plexcompare.reg.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionSettings\lfibmbaifoddfiaophkjbhfgeenialjc]
"installation_mode"="normal_installed"
"update_url"="https://dynamobsd.github.io/plexcompare/updates.xml"
"toolbar_pin"="force_pinned"
